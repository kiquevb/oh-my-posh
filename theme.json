{
  "$schema": "https://raw.githubusercontent.com/kiquevb/oh-my-posh/main/theme.json",
  "version": 1,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:text",
          "template": "\uedc5 kiquevb on ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:primary",
          "template": "{{ .Path }} ",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#44FFD2",
          "template": " \ue718 {{ .Full }} "
        },
        {
          "type": "npm",
          "style": "plain",
          "foreground": "#FE4A49",
          "template": " \ue71e {{.Full}} "
        },
        {
          "type": "pnpm",
          "style": "plain",
          "foreground": "#f69220",
          "template": " \ue865 {{ .Full }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#15C2CB",
          "template": " {{ if eq .Code 0 }}\uf00c{{ else }}\uf071 {{ .Code }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#15C2CB",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "powerline_symbol": "\ue0b0"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "project",
          "style": "plain",
          "foreground": "#FE4A49",
          "template": "\uf07b {{ .Name }}{{ if .Version }} {{ .Version }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#E54B4B",
          "template": "\uf09b</> {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}",
          "options": {}
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00fef3",
          "template": "\uf292 "
        }
      ]
    }
  ],
  "palette": {
    "text": "#FBF8EF",
    "primary": "#78B3CE",
    "secondary": "#D62828",
    "tertiary": "#F77F00",
    "accent": "#F4AE52"
  }
}
