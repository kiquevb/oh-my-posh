{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "console_title_template": "{{ .Folder }}{{ if .Root }} [ROOT]{{ end }} — {{ .Shell }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FBF8EF",
          "template": "\uedc5 kiquevb ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "#ff4c35",
          "template": "\uf0e7 "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#84ba64",
          "template": "\ued0d {{ .Full }} "
        },
        {
          "type": "npm",
          "style": "plain",
          "foreground": "#cb3837",
          "template": "\uf487 {{.Full}} ",
          "options": {
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          }
        },
        {
          "type": "pnpm",
          "style": "plain",
          "foreground": "#f69220",
          "template": "\ueb29 {{ .Full }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          }
        },
        {
          "type": "react",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue7ba {{ .Full }} ",
          "foreground": "#61dafb"
        },
        {
          "type": "python",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "cache": {
            "duration": "5m",
            "strategy": "folder"
          },
          "foreground": "#f7cb3f"
        },
        {
          "type": "terraform",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue8bd {{ .WorkspaceName }} ",
          "cache": {
            "duration": "5m",
            "strategy": "folder"
          },
          "foreground": "#5f43e9"
        },
        {
          "type": "azd",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\uebd8 {{ .DefaultEnvironment }} ",
          "foreground": "#0089d6"
        },
        {
          "type": "aws",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "cache": {
            "duration": "1h",
            "strategy": "session"
          },
          "foreground": "#ff8e04"
        },
        {
          "type": "time",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\uf017 {{ if .Env.OMP_COMMAND_START_TIME }}{{ substr 11 19 .Env.OMP_COMMAND_START_TIME }}{{ else }}{{ .CurrentDate | date \"15:04:05\" }}{{ end }} ",
          "foreground": "#bac87e"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": "\uf252 {{ .FormattedMs }} ",
          "foreground": "#d56cb4"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#c5c8c8",
          "foreground_templates": [
            "{{ if eq .Code 0 }}#84ba64{{ else }}#ff4c35{{ end }}"
          ],
          "template": "{{ if .Executed }}{{ if eq .Code 0 }}\uf00c{{ else }}\uf071 {{ .Code }}{{ end }} {{ end }}",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "project",
          "style": "plain",
          "foreground": "#61e4ff",
          "template": "\uf07b {{ if .Name }}{{ .Name }}{{ if .Version }} {{ .Version }}{{ end }}{{ else }}{{ .Folder }}{{ end }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#C898FD",
          "template": "\uf09b</>{{ if .Upstream }} ⇢ {{ $remoteBranch := replaceP \"^[^/]+/\" .Upstream \"\" }}{{ url .Upstream (printf \"%s/tree/%s\" (trimSuffix \"/\" .UpstreamURL) $remoteBranch) }}{{ end }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and .Staging.Changed .Working.Changed }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": "",
            "mapped_branches": {
              "feat/*": "\uec10 ",
              "bug/*": "\ueaaf "
            }
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ff4c35",
          "template": "\uf120 "
        }
      ]
    }
  ]
}