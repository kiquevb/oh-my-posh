{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 1,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "trailing_diamond": "d",
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "foreground": "#C898FD",
          "template": "\uf09b</> {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}",
          "options": {}
        },
        {
          "type": "react",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue7ba {{ .Full }} ",
          "foreground": "#61dafb"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#84ba64",
          "template": " \ued0d {{ .Full }} "
        },
        {
          "type": "npm",
          "style": "plain",
          "foreground": "#cb3837",
          "template": " \uf487 {{.Full}} "
        },
        {
          "type": "pnpm",
          "style": "plain",
          "foreground": "#f69220",
          "template": " \ueb29 {{ .Full }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "python",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#f7cb3f"
        },
        {
          "type": "terraform",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue8bd {{ .WorkspaceName }} ",
          "cache": {
            "duration": "5m",
            "strategy": "folder"
          },
          "foreground": "#5f43e9"
        },
        {
          "type": "azd",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uebd8 {{ .DefaultEnvironment }} ",
          "foreground": "#0089d6"
        },
        {
          "type": "aws",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "cache": {
            "duration": "1h",
            "strategy": "session"
          },
          "foreground": "#ff8e04"
        },
        {
          "type": "time",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "foreground": "#c5c8c8"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#c5c8c8"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FBF8EF",
          "template": "\uedc5 kiquevb on ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "project",
          "style": "plain",
          "foreground": "#61e4ff",
          "template": "\uf07b {{ .Name }}{{ if .Version }} {{ .Version }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#61e4ff",
          "template": "\uf07b {{ .Path }} ",
          "options": {
            "style": "folder"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ff4c35",
          "template": "\uf292 "
        }
      ]
    }
  ],
  "palette": {
    "text": "#FBF8EF",
    "primary": "#78B3CE",
    "secondary": "#D62828",
    "tertiary": "#F77F00",
    "accent": "#F4AE52"
  }
}
